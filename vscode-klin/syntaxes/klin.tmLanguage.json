{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Klin",
  "scopeName": "source.klin",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#namespaces" },
    { "include": "#declarations" },
    { "include": "#types" },
    { "include": "#literals" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.klin",
          "match": "//.*$"
        },
        {
          "name": "comment.block.klin",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.klin",
          "match": "\\b(imp)\\b"
        },
        {
          "name": "keyword.control.module.klin",
          "match": "\\b(mod|use)\\b"
        },
        {
          "name": "keyword.control.statement.klin",
          "match": "\\b(if|else|while|for|loop|match|break|continue)\\b"
        },
        {
          "name": "keyword.operator.word.klin",
          "match": "\\b(and|or|as)\\b"
        },
        {
          "name": "keyword.other.asm.klin",
          "match": "\\b(asm|in|out)\\b"
        }
      ]
    },
    "namespaces": {
      "patterns": [
        {
          "name": "entity.name.namespace.private.klin",
          "match": "::_[a-zA-Z0-9_]*"
        },
        {
          "name": "entity.name.namespace.klin",
          "match": "::[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "keyword.declaration.function.klin",
          "match": "\\b(func|_func)\\b"
        },
        {
          "captures": {
            "1": { "name": "storage.modifier.alignment.klin" },
            "2": { "name": "keyword.declaration.struct.klin" }
          },
          "match": "(\\[(?:[0-9_]+)?\\])\\s*(struct|union)\\b"
        },
        {
          "name": "keyword.declaration.struct.klin",
          "match": "\\b(struct|union)\\b"
        },
        {
          "name": "keyword.declaration.variable.klin",
          "match": "\\b(var|val|const)\\b"
        },
        {
          "name": "storage.modifier.volatile.klin",
          "match": "\\b(vol)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.klin",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|usize|isize|bool|char|string)\\b"
        },
        {
          "captures": {
            "0": { "name": "keyword.operator.pointer.klin" },
            "1": { "name": "storage.modifier.const.klin" }
          },
          "match": "\\*\\s*(const\\b)?"
        },
        {
          "captures": {
            "1": { "name": "storage.modifier.const.klin" }
          },
          "match": "\\[\\]\\s*(const\\b)?"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.null.klin",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.language.boolean.klin",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.numeric.hexadecimal.klin",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.klin",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.klin",
          "match": "\\b[0-9_]+(\\.[0-9_]+)?\\b"
        },
        {
          "name": "string.quoted.double.klin",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.klin",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.character.literal.klin",
          "match": "'(\\\\.|[^'\\\\])'"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.expression.klin",
          "match": "=>"
        },
        {
          "name": "keyword.operator.arrow.return.klin",
          "match": "->"
        },
        {
          "name": "keyword.operator.slice.klin",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.namespace.klin",
          "match": "::"
        },
        {
          "name": "keyword.operator.comparison.klin",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.klin",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.klin",
          "match": "[\\+\\-\\*/%]"
        },
        {
          "name": "keyword.operator.bitwise.klin",
          "match": "[&\\|~!]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.klin",
          "match": "[{}()\\[\\];,.:]"
        }
      ]
    }
  }
}