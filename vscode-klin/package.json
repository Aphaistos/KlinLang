{
  "name": "klin-vscode",
  "displayName": "Klin Language Support",
  "description": "Prise en charge officielle du langage Klin (syntaxe, coloration, snippets et LSP).",
  "version": "0.1.0",
  "publisher": "klin-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/klin-lang/klin-vscode.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:klin"
  ],
  "contributes": {
    "languages": [
      {
        "id": "klin",
        "aliases": [
          "Klin",
          "klin"
        ],
        "extensions": [
          ".kln"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "klin",
        "scopeName": "source.klin",
        "path": "./syntaxes/klin.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "klin",
        "path": "./snippets/klin.json"
      }
    ],
    "commands": [
      {
        "command": "klin.restartServer",
        "title": "Klin: Redémarrer le serveur de langage (LSP)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0",
    "vscode-languageclient": "^9.0.1"
  }
}
